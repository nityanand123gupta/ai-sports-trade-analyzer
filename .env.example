# Only needed for notebook 2 (02_agentic_crew_demo.ipynb). Notebook 1 needs
# no API key at all.
#
# Recommended: a free Gemini API key from Google AI Studio
# (https://aistudio.google.com/apikey, no credit card required).
GEMINI_API_KEY=

# Alternative: use Anthropic's Claude instead. If both keys are set, Gemini
# is used.
ANTHROPIC_API_KEY=

# Optional: force a specific model instead of the automatic default.
TRADE_ANALYZER_MODEL=
